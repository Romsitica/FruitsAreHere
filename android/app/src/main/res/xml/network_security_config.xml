<?xml version="1.0" encoding="utf-8"?>
<!-- 后端当前是 http（局域网明文），需要显式放行；上线换 https 后可收紧 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
